<?xml version="1.0" encoding="utf-8" ?>
<log4net>
	<appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
		<file type="log4net.Util.PatternString" value="Logs\\log.xml"/>
		<appendToFile value="true"/>
		<rollingStyle value="Date"/>
		<datePattern value="yyyyMMdd-HH"/>
		<maximumFileSize value="1MB"/>
		<lockingModel type="log4net.Appender.FileAppender+MinimalLock"/>
		<!--<layout type="log4net.Layout.XmlLayoutSchemaLog4j">
				<locationInfo value="true" />
			</layout>-->
		<layout type="log4net.Layout.PatternLayout">
			<!--<conversionPattern value="%d %C %M %-5p %m%n"/>-->
			<conversionPattern value="[%date][%-5p] %m%n" />
			<header value="%newline---------------------------------------------------------%newline[BEGIN LOGGING AT %date]%newline---------------------------------------------------------%newline" type="log4net.Util.PatternString"/>
			<footer value="%newline---------------------------------------------------------%newline[END LOGGING AT %date]%newline---------------------------------------------------------%newline" type="log4net.Util.PatternString"/>
		</layout>
	</appender>
	<logger name="CommonLogger">
		<!--<level value="DEBUG, INFO"/>-->
		<level value="DEBUG"/>
		<appender-ref ref="RollingFileAppender"/>
	</logger>
</log4net>
